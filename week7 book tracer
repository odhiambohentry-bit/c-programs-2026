#include<stdio.h>


int main(){
	
	FILE*fp;
	char title[100];
	
	//open file in append mode
	
	fp=fopen("borrowed_books.txt","a");
	
	if(fp==NULL){
		printf("error opening file!\n");
		return 1;
	}
	
	//Enter book title
	printf("enter the book title:");
	fgets(title,100,stdin);
	
	//store title in file
	
	fprintf(fp,"%s",title);
	
	//close file
	fclose(fp);
	printf("book title succesifully stored!\n");
	
	return 0;
	
}
	
