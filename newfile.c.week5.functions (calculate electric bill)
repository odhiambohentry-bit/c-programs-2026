#include<stdio.h>
double bill;
double calculateelectricbill (int units)
{
	
	if(units <=100)
	{
		bill = units * 10;
	}
	else if (units <= 200)
	{
		bill = (100*10) + (units-100)*15;
	}
	else
	
		bill=(100*10) +(100*15) +(units-200)*20;
	
	return bill;
}

int main()
{
	int units;
	double total;
	{
	printf ("Enter units consumed :");
	scanf("%d",&units);
	
	if (units <0)
	
		printf ("Invalid units !\n");
		
	}
	
	total = calculateelectricbill ( units);
	printf ("Total electricbill = Ksh %.2f\n",total);
	
	return 0;
	
	
}